<Project Sdk="Microsoft.NET.Sdk">
  <!-- SQL Server access for the database diff: catalog views and table rows. Only ever reads (SELECT). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Devscope.SqlServer</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <!-- SqlClient brings 9.0.18, which has known vulnerabilities (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7); 10.0.13 is patched. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Devscope.Core\Devscope.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Devscope.SqlServer.Tests" />
  </ItemGroup>
</Project>
