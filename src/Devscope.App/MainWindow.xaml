<Window x:Class="Devscope.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Devscope.App.ViewModels"
        xmlns:views="clr-namespace:Devscope.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="Devscope"
        Width="1440" Height="900" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <!-- View-model-first navigation: each page view model maps to its view. -->
    <DataTemplate DataType="{x:Type vm:EarDiffViewModel}">
      <views:EarDiffView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:DbDiffViewModel}">
      <views:DbDiffView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:LogsViewModel}">
      <views:LogsView />
    </DataTemplate>
  </Window.Resources>
  <Window.InputBindings>
    <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding OpenSettingsCommand}" />
  </Window.InputBindings>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Navigation rail -->
    <Border Grid.Column="0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
      <DockPanel Width="76">
        <TextBlock DockPanel.Dock="Top" Text="devscope" FontWeight="Bold" FontSize="12"
                   HorizontalAlignment="Center" Margin="0,14,0,10" Style="{StaticResource Muted}" />
        <Button DockPanel.Dock="Bottom" Command="{Binding OpenSettingsCommand}" Margin="6,0,6,10" Padding="4,8"
                HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0"
                ToolTip="Settings (Ctrl+,)" AutomationProperties.Name="Settings">
          <StackPanel>
            <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="20" HorizontalAlignment="Center" />
            <TextBlock Text="Settings" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" />
          </StackPanel>
        </Button>
        <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}"
                 BorderThickness="0" Background="Transparent" Padding="4,0"
                 AutomationProperties.Name="Navigation">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
              <Setter Property="HorizontalContentAlignment" Value="Center" />
              <Setter Property="Margin" Value="0,2" />
              <Setter Property="Padding" Value="4,10" />
              <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="20" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Title}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <ContentControl Grid.Column="1" Content="{Binding SelectedPage}" Focusable="False" />
  </Grid>
</Window>
