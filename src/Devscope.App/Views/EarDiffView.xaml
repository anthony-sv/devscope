<UserControl x:Class="Devscope.App.Views.EarDiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Devscope.App.ViewModels"
             xmlns:views="clr-namespace:Devscope.App.Views"
             xmlns:ctl="clr-namespace:Devscope.App.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:EarDiffViewModel}"
             d:DesignWidth="1200" d:DesignHeight="800">
  <UserControl.Resources>
    <!--
      File rows. The selected row (the one shown in the preview) keeps a filled background, a thick accent bar, an
      outline and an eye icon even when the focus moves to the diff: WPF's default paints an unfocused selection
      faint grey, which is easy to lose.
    -->
    <Style x:Key="DiffRowItem" TargetType="ListViewItem">
      <Setter Property="AutomationProperties.Name" Value="{Binding Path}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <EventSetter Event="MouseDoubleClick" Handler="OnRowDoubleClick" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <Grid Background="Transparent">
              <Border x:Name="Fill" Background="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0.22" Visibility="Collapsed" />
              <Border x:Name="Hover" Background="#808080" Opacity="0.10" Visibility="Collapsed" />
              <GridViewRowPresenter Margin="0,4" Columns="{TemplateBinding GridView.ColumnCollection}" Content="{TemplateBinding Content}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
              <Border x:Name="Outline" BorderThickness="1.5" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
              <Border x:Name="Bar" Width="5" HorizontalAlignment="Left" Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Hover" Property="Visibility" Value="Visible" />
              </Trigger>
              <!-- Same look whether or not the list has the focus (Selector.IsSelectionActive is ignored on purpose). -->
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Fill" Property="Visibility" Value="Visible" />
                <Setter TargetName="Outline" Property="Visibility" Value="Visible" />
                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </UserControl.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Inputs -->
    <Border Grid.Row="0" Style="{StaticResource Card}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Left (old)" VerticalAlignment="Center" Margin="0,0,12,0" />
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding LeftPath, UpdateSourceTrigger=PropertyChanged}"
                 ctl:Behaviors.AcceptsPathDrop="True" FontFamily="{StaticResource MonoFont}"
                 AutomationProperties.Name="Left archive path"
                 ToolTip="EAR/WAR/JAR file or exploded folder. Local or \\server\share path. You can drop a file here." />
        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
          <Button Style="{StaticResource IconButton}" Content="&#xE8E5;" ToolTip="Pick archive file" Command="{Binding BrowseLeftFileCommand}" />
          <Button Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="Pick exploded folder" Command="{Binding BrowseLeftFolderCommand}" />
        </StackPanel>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Right (new)" VerticalAlignment="Center" Margin="0,8,12,0" />
        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Text="{Binding RightPath, UpdateSourceTrigger=PropertyChanged}"
                 ctl:Behaviors.AcceptsPathDrop="True" FontFamily="{StaticResource MonoFont}"
                 AutomationProperties.Name="Right archive path"
                 ToolTip="EAR/WAR/JAR file or exploded folder. Local or \\server\share path. You can drop a file here." />
        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="0,8,0,0">
          <Button Style="{StaticResource IconButton}" Content="&#xE8E5;" ToolTip="Pick archive file" Command="{Binding BrowseRightFileCommand}" />
          <Button Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="Pick exploded folder" Command="{Binding BrowseRightFolderCommand}" />
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center">
          <Button Content="Compare" Command="{Binding CompareCommand}" IsDefault="True" MinWidth="110"
                  Style="{DynamicResource AccentButtonStyle}" />
          <Button Content="Cancel" Command="{Binding CompareCancelCommand}" MinWidth="110" Margin="0,6,0,0"
                  Visibility="{Binding CompareCommand.IsRunning, Converter={StaticResource VisibleWhen}}" />
          <Button Content="Swap sides" Command="{Binding SwapCommand}" MinWidth="110" Margin="0,6,0,0"
                  Visibility="{Binding CompareCommand.IsRunning, Converter={StaticResource CollapsedWhen}}" />
        </StackPanel>

        <DockPanel Grid.Row="2" Grid.ColumnSpan="4" Margin="0,10,0,0">
          <ProgressBar DockPanel.Dock="Left" Width="120" Height="4" IsIndeterminate="True" Margin="0,0,10,0"
                       Visibility="{Binding CompareCommand.IsRunning, Converter={StaticResource VisibleWhen}}" />
          <TextBlock DockPanel.Dock="Right" Text="{Binding BackgroundStatus}" Style="{StaticResource Muted}" FontSize="12" Margin="12,0,0,0"
                     VerticalAlignment="Center" Visibility="{Binding BackgroundStatus, Converter={StaticResource VisibleWhen}}" />
          <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- Decompiler status (configured in Settings) and auto-refresh. -->
        <DockPanel Grid.Row="3" Grid.ColumnSpan="4" Margin="0,8,0,0">
          <CheckBox DockPanel.Dock="Right" Content="Auto-refresh" IsChecked="{Binding AutoRefresh}" VerticalAlignment="Center"
                    ToolTip="Rescan when either side changes on disk (e.g. after a redeploy). Waits until the files stop changing first." />
          <Button DockPanel.Dock="Left" Content="Settings…" Command="{Binding OpenSettingsCommand}" Margin="0,0,10,0"
                  ToolTip="Java, Vineflower, background decompiling and caches" />
          <TextBlock Text="{Binding DecompilerHeader}" ToolTip="{Binding DecompilerStatus}" Style="{StaticResource Muted}" FontSize="12"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
      </Grid>
    </Border>

    <!-- Result filters: status chips, path search and more options. -->
    <DockPanel Grid.Row="1" Margin="0,12,0,0" Visibility="{Binding HasResult, Converter={StaticResource VisibleWhen}}">
      <Button x:Name="MoreButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE712;"
              ToolTip="More options" Click="OnMoreClick">
        <Button.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Show files with identical text" IsCheckable="True" IsChecked="{Binding ShowSameText}"
                      ToolTip="Modified files whose lines all read the same: only line endings, a byte order mark or compiler output differ" />
            <MenuItem Header="Show archive rows" IsCheckable="True" IsChecked="{Binding ShowArchives}"
                      ToolTip="The nested WAR/JAR rows themselves (their status is derived from their content)" />
            <Separator />
            <MenuItem Header="Export CSV…" Command="{Binding ExportCommand}" />
          </ContextMenu>
        </Button.ContextMenu>
      </Button>
      <TextBox DockPanel.Dock="Right" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" Width="300"
               AutomationProperties.Name="Filter paths" ToolTip="Filter by path" />
      <WrapPanel VerticalAlignment="Center">
        <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding ShowModified}" AutomationProperties.Name="Modified"
                      ToolTip="Files whose content changed">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="{StaticResource ModifiedBrush}" />
            <TextBlock Text="Modified" />
            <TextBlock Text="{Binding ChangedCount, StringFormat=' {0:N0}'}" Style="{StaticResource Muted}" />
          </StackPanel>
        </ToggleButton>
        <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding ShowAdded}" AutomationProperties.Name="Added">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="{StaticResource AddedBrush}" />
            <TextBlock Text="Added" />
            <TextBlock Text="{Binding Comparison.Added, StringFormat=' {0:N0}'}" Style="{StaticResource Muted}" />
          </StackPanel>
        </ToggleButton>
        <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding ShowRemoved}" AutomationProperties.Name="Removed">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="{StaticResource RemovedBrush}" />
            <TextBlock Text="Removed" />
            <TextBlock Text="{Binding Comparison.Removed, StringFormat=' {0:N0}'}" Style="{StaticResource Muted}" />
          </StackPanel>
        </ToggleButton>
        <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding ShowUnchanged}" AutomationProperties.Name="Unchanged">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="{StaticResource UnchangedBrush}" />
            <TextBlock Text="Unchanged" />
            <TextBlock Text="{Binding Comparison.Unchanged, StringFormat=' {0:N0}'}" Style="{StaticResource Muted}" />
          </StackPanel>
        </ToggleButton>
      </WrapPanel>
    </DockPanel>

    <!-- How many identical-text files there are, and a way to list them. -->
    <TextBlock Grid.Row="2" Margin="2,8,0,0" TextWrapping="Wrap" FontSize="12" Style="{StaticResource Muted}"
               AutomationProperties.Name="Identical text hint"
               Visibility="{Binding SameTextCount, Converter={StaticResource VisibleWhen}}">
      <Run Text="&#xE946;" FontFamily="{StaticResource IconFont}" BaselineAlignment="Center" />
      <Run Text="{Binding SameTextHint, Mode=OneWay}" />
      <Hyperlink Command="{Binding ToggleSameTextCommand}"><Run Text="{Binding SameTextAction, Mode=OneWay}" /></Hyperlink>
    </TextBlock>

    <!-- Results and preview -->
    <Grid Grid.Row="3" Margin="0,8,0,0" Visibility="{Binding HasResult, Converter={StaticResource VisibleWhen}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="5*" MinWidth="480" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="6*" MinWidth="320" />
      </Grid.ColumnDefinitions>

      <ListView Grid.Column="0" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                ItemContainerStyle="{StaticResource DiffRowItem}" ctl:Behaviors.FillColumn="2"
                VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                AutomationProperties.Name="Differences"
                ToolTip="Click a file to preview its diff; double-click (or press Enter) to open it in the diff window">
        <ListView.InputBindings>
          <KeyBinding Key="Enter" Command="{Binding OpenInWindowCommand}" CommandParameter="{Binding SelectedRow}" />
        </ListView.InputBindings>
        <ListView.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Open in diff window" Command="{Binding OpenInWindowCommand}" CommandParameter="{Binding SelectedRow}" InputGestureText="Enter" />
            <MenuItem Header="Copy path" Command="{Binding CopyPathCommand}" CommandParameter="{Binding SelectedRow}" />
          </ContextMenu>
        </ListView.ContextMenu>
        <ListView.View>
          <GridView>
            <!-- Eye on the previewed row: a marker that does not depend on colour. -->
            <GridViewColumn Width="30">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE7B3;" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                             AutomationProperties.Name="Shown in preview"
                             Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}, Converter={StaticResource VisibleWhen}}" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Width="96">
              <GridViewColumn.Header>
                <GridViewColumnHeader Content="{Binding StatusHeader}" CommandParameter="{x:Static vm:EarDiffSortKey.Status}" Command="{Binding SortByCommand}" HorizontalContentAlignment="Left" />
              </GridViewColumn.Header>
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Badge}" Background="{Binding Status, Converter={StaticResource BadgeBrush}}">
                    <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Status}" />
                  </Border>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Width="360">
              <GridViewColumn.Header>
                <GridViewColumnHeader Content="{Binding PathHeader}" CommandParameter="{x:Static vm:EarDiffSortKey.Path}" Command="{Binding SortByCommand}" HorizontalContentAlignment="Left" />
              </GridViewColumn.Header>
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel ToolTip="{Binding Path}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <Border Style="{StaticResource Badge}" Margin="8,0,0,0" BorderThickness="1" Background="Transparent"
                              BorderBrush="{StaticResource UnchangedBrush}"
                              Visibility="{Binding IsSameText, Converter={StaticResource VisibleWhen}}"
                              ToolTip="Modified, but every line reads the same: only line endings, a byte order mark or compiler output differ">
                        <TextBlock Text="same text" FontSize="11" Style="{StaticResource Muted}" />
                      </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Path}" FontSize="11" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Width="80" DisplayMemberBinding="{Binding Left.Length, Converter={StaticResource Bytes}, FallbackValue='—'}">
              <GridViewColumn.Header>
                <GridViewColumnHeader Content="{Binding LeftHeader}" CommandParameter="{x:Static vm:EarDiffSortKey.Left}" Command="{Binding SortByCommand}" HorizontalContentAlignment="Left" />
              </GridViewColumn.Header>
            </GridViewColumn>
            <GridViewColumn Width="80" DisplayMemberBinding="{Binding Right.Length, Converter={StaticResource Bytes}, FallbackValue='—'}">
              <GridViewColumn.Header>
                <GridViewColumnHeader Content="{Binding RightHeader}" CommandParameter="{x:Static vm:EarDiffSortKey.Right}" Command="{Binding SortByCommand}" HorizontalContentAlignment="Left" />
              </GridViewColumn.Header>
            </GridViewColumn>
          </GridView>
        </ListView.View>
      </ListView>

      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" />

      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
        <DockPanel>
          <Button DockPanel.Dock="Top" HorizontalAlignment="Right" Margin="0,8,8,-4" Command="{Binding OpenInWindowCommand}"
                  Visibility="{Binding Preview.HasEntry, Converter={StaticResource VisibleWhen}}"
                  ToolTip="Open this file in a tab of the diff window (or double-click it in the list)">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" Margin="0,0,6,0" />
              <TextBlock Text="Open in window" />
            </StackPanel>
          </Button>
          <views:DiffDocumentView DataContext="{Binding Preview}" />
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
