<UserControl x:Class="Devscope.App.Views.EarDiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Devscope.App.ViewModels"
             xmlns:ctl="clr-namespace:Devscope.App.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:EarDiffViewModel}"
             d:DesignWidth="1200" d:DesignHeight="800">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Inputs -->
    <Border Grid.Row="0" Style="{StaticResource Card}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Left (old)" VerticalAlignment="Center" Margin="0,0,12,0" />
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding LeftPath, UpdateSourceTrigger=PropertyChanged}"
                 ctl:Behaviors.AcceptsPathDrop="True" FontFamily="{StaticResource MonoFont}"
                 AutomationProperties.Name="Left archive path"
                 ToolTip="EAR/WAR/JAR file or exploded folder. Local or \\server\share path. You can drop a file here." />
        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
          <Button Style="{StaticResource IconButton}" Content="&#xE8E5;" ToolTip="Pick archive file" Command="{Binding BrowseLeftFileCommand}" />
          <Button Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="Pick exploded folder" Command="{Binding BrowseLeftFolderCommand}" />
        </StackPanel>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Right (new)" VerticalAlignment="Center" Margin="0,8,12,0" />
        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Text="{Binding RightPath, UpdateSourceTrigger=PropertyChanged}"
                 ctl:Behaviors.AcceptsPathDrop="True" FontFamily="{StaticResource MonoFont}"
                 AutomationProperties.Name="Right archive path"
                 ToolTip="EAR/WAR/JAR file or exploded folder. Local or \\server\share path. You can drop a file here." />
        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="0,8,0,0">
          <Button Style="{StaticResource IconButton}" Content="&#xE8E5;" ToolTip="Pick archive file" Command="{Binding BrowseRightFileCommand}" />
          <Button Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="Pick exploded folder" Command="{Binding BrowseRightFolderCommand}" />
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center">
          <Button Content="Compare" Command="{Binding CompareCommand}" IsDefault="True" MinWidth="110"
                  Style="{DynamicResource AccentButtonStyle}" />
          <Button Content="Cancel" Command="{Binding CompareCancelCommand}" MinWidth="110" Margin="0,6,0,0"
                  Visibility="{Binding CompareCommand.IsRunning, Converter={StaticResource VisibleWhen}}" />
          <Button Content="Swap sides" Command="{Binding SwapCommand}" MinWidth="110" Margin="0,6,0,0"
                  Visibility="{Binding CompareCommand.IsRunning, Converter={StaticResource CollapsedWhen}}" />
        </StackPanel>

        <DockPanel Grid.Row="2" Grid.ColumnSpan="4" Margin="0,10,0,0">
          <ProgressBar DockPanel.Dock="Left" Width="120" Height="4" IsIndeterminate="True" Margin="0,0,10,0"
                       Visibility="{Binding CompareCommand.IsRunning, Converter={StaticResource VisibleWhen}}" />
          <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- Optional decompiler: .class files are shown as Java source when Java + Vineflower are available. -->
        <Expander Grid.Row="3" Grid.ColumnSpan="4" Margin="0,8,0,0" Header="{Binding DecompilerHeader}"
                  AutomationProperties.Name="Java decompiler settings">
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="java.exe" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding JavaPath, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource MonoFont}"
                     ctl:Behaviors.AcceptsPathDrop="True" AutomationProperties.Name="Java executable path"
                     ToolTip="Leave empty to use JAVA_HOME or PATH. Java 17 or newer." />
            <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE8E5;" ToolTip="Pick java.exe" Command="{Binding BrowseJavaCommand}" />

            <TextBlock Grid.Row="1" Text="Vineflower jar" VerticalAlignment="Center" Margin="0,8,12,0" />
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Text="{Binding DecompilerJarPath, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource MonoFont}"
                     ctl:Behaviors.AcceptsPathDrop="True" AutomationProperties.Name="Decompiler jar path"
                     ToolTip="Leave empty to use vineflower*.jar next to Devscope.exe or in its tools folder." />
            <Button Grid.Row="1" Grid.Column="2" Margin="4,8,0,0" Style="{StaticResource IconButton}" Content="&#xE8E5;" ToolTip="Pick decompiler jar" Command="{Binding BrowseDecompilerJarCommand}" />

            <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Margin="0,8,0,0" Text="{Binding DecompilerStatus}" TextWrapping="Wrap" FontSize="12"
                       Style="{StaticResource Muted}" />
          </Grid>
        </Expander>
      </Grid>
    </Border>

    <!-- Result filters -->
    <DockPanel Grid.Row="1" Margin="0,12,0,8" Visibility="{Binding HasResult, Converter={StaticResource VisibleWhen}}">
      <Button DockPanel.Dock="Right" Content="Export CSV…" Command="{Binding ExportCommand}" />
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="0,0,12,0">
        <Border Style="{StaticResource Badge}" Background="{StaticResource ModifiedBrush}" Margin="0,0,6,0">
          <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Comparison.Modified, StringFormat='{}{0:N0} modified'}" />
        </Border>
        <Border Style="{StaticResource Badge}" Background="{StaticResource AddedBrush}" Margin="0,0,6,0">
          <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Comparison.Added, StringFormat='{}{0:N0} added'}" />
        </Border>
        <Border Style="{StaticResource Badge}" Background="{StaticResource RemovedBrush}" Margin="0,0,6,0">
          <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Comparison.Removed, StringFormat='{}{0:N0} removed'}" />
        </Border>
      </StackPanel>
      <CheckBox Content="Unchanged" IsChecked="{Binding ShowUnchanged}" Margin="0,0,12,0" VerticalAlignment="Center" />
      <CheckBox Content="Archive rows" IsChecked="{Binding ShowArchives}" Margin="0,0,12,0" VerticalAlignment="Center"
                ToolTip="Show the nested WAR/JAR rows themselves (their status is derived from their content)" />
      <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" Width="320" HorizontalAlignment="Left"
               AutomationProperties.Name="Filter paths" ToolTip="Filter by path" />
    </DockPanel>

    <!-- Results and detail -->
    <Grid Grid.Row="2" Visibility="{Binding HasResult, Converter={StaticResource VisibleWhen}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="5*" MinWidth="280" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="6*" MinWidth="320" />
      </Grid.ColumnDefinitions>

      <ListView Grid.Column="0" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                AutomationProperties.Name="Differences">
        <ListView.ItemContainerStyle>
          <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Path}" />
          </Style>
        </ListView.ItemContainerStyle>
        <ListView.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Copy path" Command="{Binding CopyPathCommand}" CommandParameter="{Binding SelectedRow}" />
          </ContextMenu>
        </ListView.ContextMenu>
        <ListView.View>
          <GridView>
            <GridViewColumn Header="Status" Width="96">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Badge}" Background="{Binding Status, Converter={StaticResource BadgeBrush}}">
                    <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Status}" />
                  </Border>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Path" Width="360">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel ToolTip="{Binding Path}">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Path}" FontSize="11" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Left" Width="72" DisplayMemberBinding="{Binding Left.Length, Converter={StaticResource Bytes}, FallbackValue='—'}" />
            <GridViewColumn Header="Right" Width="72" DisplayMemberBinding="{Binding Right.Length, Converter={StaticResource Bytes}, FallbackValue='—'}" />
          </GridView>
        </ListView.View>
      </ListView>

      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" />

      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
        <Grid>
          <TextBlock Text="Select a file to see what changed." Style="{StaticResource Muted}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Visibility="{Binding SelectedRow, Converter={StaticResource CollapsedWhen}}" />

          <DockPanel Visibility="{Binding Detail, Converter={StaticResource VisibleWhen}}">
            <DockPanel DockPanel.Dock="Top" Margin="12,10">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                          Visibility="{Binding Detail.IsText, Converter={StaticResource VisibleWhen}}">
                <Button Style="{StaticResource IconButton}" Content="&#xE70E;" ToolTip="Previous change" Command="{Binding PreviousChangeCommand}" />
                <Button Style="{StaticResource IconButton}" Content="&#xE70D;" ToolTip="Next change" Command="{Binding NextChangeCommand}" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="{Binding SelectedRow.Name}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Detail.Summary}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
              </StackPanel>
            </DockPanel>

            <!-- Side-by-side text diff; wrapped lines keep both halves aligned. -->
            <ListBox ItemsSource="{Binding Detail.Lines}" SelectedItem="{Binding SelectedLine}"
                     Visibility="{Binding Detail.IsText, Converter={StaticResource VisibleWhen}}"
                     ItemContainerStyle="{StaticResource DenseItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     ctl:Behaviors.ScrollSelectionIntoView="True"
                     BorderThickness="0" Background="Transparent"
                     AutomationProperties.Name="Text differences">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="44" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="44" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Grid.ColumnSpan="2" Background="{Binding LeftKind, Converter={StaticResource LineBrush}}" />
                    <Border Grid.Column="2" Grid.ColumnSpan="2" Background="{Binding RightKind, Converter={StaticResource LineBrush}}" />
                    <TextBlock Grid.Column="0" Text="{Binding LeftNumber}" Style="{StaticResource MonoText}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextAlignment="Right" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1" Text="{Binding LeftText}" Style="{StaticResource MonoText}" TextWrapping="Wrap" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="2" Text="{Binding RightNumber}" Style="{StaticResource MonoText}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextAlignment="Right" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="3" Text="{Binding RightText}" Style="{StaticResource MonoText}" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>

          <StackPanel VerticalAlignment="Top" Visibility="{Binding IsLoadingDetail, Converter={StaticResource VisibleWhen}}">
            <ProgressBar IsIndeterminate="True" Height="4" />
            <TextBlock Text="{Binding LoadingText}" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,40,0,0" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
