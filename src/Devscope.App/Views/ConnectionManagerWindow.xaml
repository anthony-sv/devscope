<Window x:Class="Devscope.App.Views.ConnectionManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Devscope.App.ViewModels"
        xmlns:db="clr-namespace:Devscope.Core.Database;assembly=Devscope.Core"
        xmlns:ctl="clr-namespace:Devscope.App.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:ConnectionManagerViewModel}"
        Title="Database connections" Width="980" Height="720" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Window.Resources>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,8,12,0" />
    </Style>
    <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
  </Window.Resources>

  <DockPanel Margin="20">
    <!-- Footer -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="96" Margin="0,0,8,0" />
        <Button Content="Save" Command="{Binding SaveCommand}" IsDefault="True" MinWidth="96" Style="{DynamicResource AccentButtonStyle}" />
      </StackPanel>
      <TextBlock Text="{Binding ValidationError}" Foreground="{StaticResource ErrorBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
    </DockPanel>

    <!-- Why the window opened, e.g. a password is needed. -->
    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12" BorderBrush="{StaticResource WarningBrush}"
            Visibility="{Binding Message, Converter={StaticResource VisibleWhen}}">
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontWeight="SemiBold" />
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Saved connections -->
      <DockPanel Grid.Column="0">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="New connection" Command="{Binding AddCommand}" />
            <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Duplicate (e.g. the same database on another server)" Command="{Binding DuplicateCommand}" />
            <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Delete connection" Command="{Binding RemoveCommand}" />
          </StackPanel>
          <TextBlock Text="CONNECTIONS" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0" />
        </DockPanel>

        <!-- Paste a connection string from a config file to create a connection. -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
          <TextBlock Text="FROM A CONNECTION STRING" Style="{StaticResource SectionTitle}" />
          <TextBox Text="{Binding ConnectionStringText, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                   TextWrapping="Wrap" AcceptsReturn="False" MinHeight="54" VerticalContentAlignment="Top"
                   AutomationProperties.Name="Connection string"
                   ToolTip="e.g. Server=sql01;Database=Billing;Integrated Security=True. A password in it is kept like a typed one." />
          <Button Content="Add from connection string" Command="{Binding ImportCommand}" Margin="0,6,0,0" HorizontalAlignment="Stretch" />
        </StackPanel>

        <ListBox ItemsSource="{Binding Connections}" SelectedItem="{Binding SelectedConnection}" AutomationProperties.Name="Connections">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,2">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Target}" FontSize="11" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                           FontFamily="{StaticResource MonoFont}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <!-- The selected connection -->
      <TextBlock Grid.Column="2" Text="Add a connection, or paste a connection string on the left." Style="{StaticResource Muted}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Visibility="{Binding HasSelection, Converter={StaticResource CollapsedWhen}}" />
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelection, Converter={StaticResource VisibleWhen}}">
        <Grid DataContext="{Binding SelectedConnection}" Margin="0,0,4,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Text="Name" Style="{StaticResource Label}" Margin="0,0,12,0" />
          <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" Margin="0"
                   AutomationProperties.Name="Connection name" ToolTip="e.g. Billing PROD, Billing TEST" />

          <TextBlock Grid.Row="1" Text="Server" Style="{StaticResource Label}" />
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}"
                   FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="Server"
                   ToolTip="Host, instance and port as in SQL Server Management Studio: sql01, sql01\PROD, sql01.corp.local,1433" />

          <TextBlock Grid.Row="2" Text="Database" Style="{StaticResource Label}" />
          <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}"
                   FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="Database" />

          <TextBlock Grid.Row="3" Text="Log in with" Style="{StaticResource Label}" />
          <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" HorizontalAlignment="Left" MinWidth="240"
                    ItemsSource="{x:Static vm:ConnectionManagerViewModel.AuthenticationModes}" SelectedItem="{Binding Authentication}"
                    AutomationProperties.Name="Authentication">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock>
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Text" Value="Windows account (integrated)" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding}" Value="{x:Static db:DbAuthentication.SqlLogin}">
                          <Setter Property="Text" Value="SQL Server login" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <TextBlock Grid.Row="4" Text="User name" Style="{StaticResource Label}" Visibility="{Binding IsSqlLogin, Converter={StaticResource VisibleWhen}}" />
          <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}"
                   AutomationProperties.Name="User name" Visibility="{Binding IsSqlLogin, Converter={StaticResource VisibleWhen}}" />

          <TextBlock Grid.Row="5" Text="Password" Style="{StaticResource Label}" Visibility="{Binding IsSqlLogin, Converter={StaticResource VisibleWhen}}" />
          <StackPanel Grid.Row="5" Grid.Column="1" Visibility="{Binding IsSqlLogin, Converter={StaticResource VisibleWhen}}">
            <PasswordBox Margin="0,8,0,0" ctl:Behaviors.Password="{Binding Password, Mode=TwoWay}" AutomationProperties.Name="Password" />
            <CheckBox Content="Save the password, encrypted for my Windows account" IsChecked="{Binding SavePassword}" Margin="0,6,0,0"
                      ToolTip="Encrypted with Windows (DPAPI): only your account on this computer can read it. Unticked, it is asked once per session." />
          </StackPanel>

          <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Text="CONNECTION" Style="{StaticResource SectionTitle}" Margin="0,20,0,0" />
          <StackPanel Grid.Row="7" Grid.ColumnSpan="2">
            <CheckBox Content="Encrypt the connection" IsChecked="{Binding Encrypt}" Margin="0,6,0,0"
                      ToolTip="TLS encryption, required by default by current SQL Server drivers" />
            <CheckBox Content="Trust the server certificate" IsChecked="{Binding TrustServerCertificate}" Margin="0,6,0,0"
                      ToolTip="Accept a self-signed or internal certificate without validating it. Typical for test servers." />
            <CheckBox Content="Read-only intent" IsChecked="{Binding ReadOnlyIntent}" Margin="0,6,0,0"
                      ToolTip="ApplicationIntent=ReadOnly: an availability group listener routes to a readable secondary, keeping load off the primary" />
          </StackPanel>

          <TextBlock Grid.Row="8" Text="Query timeout (s)" Style="{StaticResource Label}" />
          <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding CommandTimeoutSeconds}" Style="{StaticResource Field}" Width="90" HorizontalAlignment="Left"
                   AutomationProperties.Name="Query timeout in seconds"
                   ToolTip="How long reading the schema may take. Row comparisons have no limit and can be cancelled." />

          <TextBlock Grid.Row="9" Text="More options" Style="{StaticResource Label}" />
          <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding AdditionalOptions, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}"
                   FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="Additional connection string options"
                   ToolTip="Extra connection string keywords, e.g. MultiSubnetFailover=True;Connect Timeout=30" />

          <DockPanel Grid.Row="10" Grid.ColumnSpan="2" Margin="0,20,0,0">
            <Button DockPanel.Dock="Left" Content="Test connection" MinWidth="130"
                    Command="{Binding DataContext.TestCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <TextBlock Text="{Binding TestStatus}" Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0" />
          </DockPanel>

          <TextBlock Grid.Row="11" Grid.ColumnSpan="2" Margin="0,16,0,0" FontSize="12" Style="{StaticResource Muted}" TextWrapping="Wrap"
                     Text="Devscope only reads: catalog views for the schema and SELECT for rows. A login with db_datareader and VIEW DEFINITION is enough, and safest." />
        </Grid>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
