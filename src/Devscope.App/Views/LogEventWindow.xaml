<Window x:Class="Devscope.App.Views.LogEventWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Devscope.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:LogEventViewModel}"
        Title="{Binding Title}" Icon="/Assets/devscope.ico"
        Width="1100" Height="700" MinWidth="480" MinHeight="260"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True">
  <Window.InputBindings>
    <KeyBinding Key="Escape" Command="{x:Static ApplicationCommands.Close}" />
  </Window.InputBindings>
  <Window.CommandBindings>
    <CommandBinding Command="{x:Static ApplicationCommands.Close}" Executed="OnClose" />
  </Window.CommandBindings>

  <DockPanel Margin="16">
    <!-- Header: time, level, source and line count -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding WrapLines}" ToolTip="Wrap long lines" Content="Wrap" FontSize="12" />
        <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Copy event" Command="{Binding CopyCommand}" />
        <Button Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="Show file in Explorer" Command="{Binding RevealCommand}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="{Binding Entry.Timestamp, Converter={StaticResource Timestamp}}" Style="{StaticResource MonoText}" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,10,0" />
        <Border Style="{StaticResource Badge}" Background="{Binding Entry.Severity, Converter={StaticResource BadgeBrush}}" Margin="0,0,8,0">
          <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Entry.Severity, Converter={StaticResource SeverityLabel}}" />
        </Border>
        <Border Style="{StaticResource Badge}" Background="{Binding Entry.Source.ColorIndex, Converter={StaticResource IndexBrush}}" Margin="0,0,10,0">
          <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Entry.Source.Environment}" />
        </Border>
        <TextBlock Text="{Binding Header}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
      </StackPanel>
    </DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="{Binding Entry.Source.FilePath}" Style="{StaticResource Muted}" FontSize="12"
               TextTrimming="CharacterEllipsis" ToolTip="{Binding Entry.Source.FilePath}" Margin="0,0,0,8" />

    <Border Style="{StaticResource Card}" Padding="0">
      <TextBox x:Name="Body" Text="{Binding Entry.Text, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
               FontFamily="{StaticResource MonoFont}" FontSize="12.5" Padding="10,8"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
               AutomationProperties.Name="Event text">
        <TextBox.Style>
          <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding WrapLines}" Value="True">
                <Setter Property="TextWrapping" Value="Wrap" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBox.Style>
      </TextBox>
    </Border>
  </DockPanel>
</Window>
