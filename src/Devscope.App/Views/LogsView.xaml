<UserControl x:Class="Devscope.App.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Devscope.App.ViewModels"
             xmlns:ctl="clr-namespace:Devscope.App.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:LogsViewModel}"
             d:DesignWidth="1300" d:DesignHeight="800">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="290" MinWidth="220" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ===== Sidebar: workspaces and ad-hoc paths ===== -->
    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="16,16,8,16">
        <DockPanel Margin="0,0,0,6">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="New workspace" Command="{Binding NewWorkspaceCommand}" />
            <Button Style="{StaticResource IconButton}" Content="&#xE70F;" ToolTip="Edit workspace" Command="{Binding EditWorkspaceCommand}" />
            <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Delete workspace" Command="{Binding DeleteWorkspaceCommand}" />
          </StackPanel>
          <TextBlock Text="WORKSPACES" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0" />
        </DockPanel>

        <ComboBox ItemsSource="{Binding Workspaces}" SelectedItem="{Binding SelectedWorkspace}" DisplayMemberPath="Name"
                  AutomationProperties.Name="Workspace" />
        <TextBlock Text="No workspace yet. Create one to group an app's logs across environments."
                   Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                   Visibility="{Binding Workspaces.Count, Converter={StaticResource CollapsedWhen}}" />

        <ItemsControl ItemsSource="{Binding SelectedWorkspace.Environments}" Margin="0,8,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{Binding ColorIndex, Converter={StaticResource IndexBrush}}" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  </StackPanel>
                  <TextBlock Text="{Binding Summary}" FontSize="11" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" MaxWidth="220" ToolTip="{Binding Summary}" />
                </StackPanel>
              </CheckBox>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Content="Open selected environments" Command="{Binding OpenWorkspaceCommand}" Margin="0,8,0,0"
                HorizontalAlignment="Stretch" Style="{DynamicResource AccentButtonStyle}" />

        <TextBlock Text="QUICK OPEN" Style="{StaticResource SectionTitle}" Margin="0,24,0,6" />
        <TextBox Text="{Binding QuickPath, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                 ctl:Behaviors.AcceptsPathDrop="True" AutomationProperties.Name="Log file or folder path"
                 ToolTip="A log file or a folder (searched recursively). Local or \\server\share. Drop a file here." />
        <DockPanel Margin="0,6,0,0">
          <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Margin="0" Content="&#xE8E5;" ToolTip="Pick file" Command="{Binding BrowseQuickFileCommand}" />
          <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="Pick folder" Command="{Binding BrowseQuickFolderCommand}" />
          <Button Content="Open" Command="{Binding QuickOpenCommand}" Margin="6,0,0,0" HorizontalAlignment="Stretch" />
        </DockPanel>

        <StackPanel Visibility="{Binding SourceStatuses.Count, Converter={StaticResource VisibleWhen}}">
          <TextBlock Text="SOURCES" Style="{StaticResource SectionTitle}" Margin="0,24,0,6" />
          <ItemsControl ItemsSource="{Binding SourceStatuses}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,8">
                  <TextBlock FontSize="12">
                    <Run Text="{Binding Environment, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="{Binding FileCount, Mode=OneWay, StringFormat='· {0} file(s)'}" />
                  </TextBlock>
                  <TextBlock Text="{Binding Path}" FontSize="11" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Error}" FontSize="11" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"
                             Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                  Background="{DynamicResource CardStrokeColorDefaultBrush}" />

    <!-- ===== Viewer ===== -->
    <Grid Grid.Column="2" Margin="8,16,16,16">
      <TextBlock Text="Open a workspace or a path to start tailing logs." Style="{StaticResource Muted}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Visibility="{Binding IsSessionOpen, Converter={StaticResource CollapsedWhen}}" />

      <Grid Visibility="{Binding IsSessionOpen, Converter={StaticResource VisibleWhen}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" MinHeight="120" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="200" MinHeight="60" />
        </Grid.RowDefinitions>

        <!-- Title and live controls -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <TextBlock Text="{Binding CountText}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding IsFollowing}" ToolTip="Follow (auto-scroll to newest)">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE74B;" />
            </ToggleButton>
            <ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding IsPaused}" ToolTip="Pause live updates (new lines are buffered)">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE769;" />
            </ToggleButton>
            <Button Style="{StaticResource IconButton}" Content="&#xE894;" ToolTip="Clear the view" Command="{Binding ClearCommand}" />
            <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Close" Command="{Binding CloseSessionCommand}" />
          </StackPanel>
          <ProgressBar DockPanel.Dock="Right" Width="80" Height="4" IsIndeterminate="True" Margin="12,0"
                       Visibility="{Binding IsLoading, Converter={StaticResource VisibleWhen}}" />
          <TextBlock Text="{Binding SessionTitle}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" ToolTip="{Binding SessionTitle}" />
        </DockPanel>

        <!-- Filters -->
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="3*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                     AutomationProperties.Name="Search" ToolTip="Show events containing this text (or matching this regex)" />
            <ToggleButton Grid.Column="1" Style="{StaticResource IconToggle}" IsChecked="{Binding UseRegex}" ToolTip="Regular expression"
                          Content=".*" FontFamily="{StaticResource MonoFont}" />
            <ToggleButton Grid.Column="2" Style="{StaticResource IconToggle}" IsChecked="{Binding MatchCase}" ToolTip="Match case"
                          Content="Aa" Margin="4,0,8,0" />
            <TextBox Grid.Column="3" Text="{Binding ExcludeText, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                     AutomationProperties.Name="Exclude" ToolTip="Hide events containing this text (or matching this regex)" />
          </Grid>
          <TextBlock Text="{Binding FilterError}" Foreground="{StaticResource ErrorBrush}" FontSize="12" Margin="0,4,0,0"
                     Visibility="{Binding FilterError, Converter={StaticResource VisibleWhen}}" />

          <WrapPanel Margin="0,8,0,0">
            <ItemsControl ItemsSource="{Binding SeverityChips}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding IsEnabled}">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="{Binding Value, Converter={StaticResource BadgeBrush}}" Stroke="{DynamicResource TextFillColorTertiaryBrush}" StrokeThickness="0.5" />
                      <TextBlock Text="{Binding Label}" />
                      <TextBlock Text="{Binding Count, StringFormat=' {0:N0}'}" Style="{StaticResource Muted}" />
                    </StackPanel>
                  </ToggleButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Width="1" Margin="6,4,12,4" Background="{DynamicResource CardStrokeColorDefaultBrush}" />
            <ItemsControl ItemsSource="{Binding EnvironmentChips}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding IsEnabled}">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="{Binding ColorIndex, Converter={StaticResource IndexBrush}}" />
                      <TextBlock Text="{Binding Label}" />
                      <TextBlock Text="{Binding Count, StringFormat=' {0:N0}'}" Style="{StaticResource Muted}" />
                    </StackPanel>
                  </ToggleButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </WrapPanel>
        </StackPanel>

        <!-- Event list (virtualized; handles hundreds of thousands of rows) -->
        <ListBox x:Name="EventList" Grid.Row="2" ItemsSource="{Binding VisibleEntries}" SelectedItem="{Binding SelectedEntry}"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ctl:Behaviors.AutoScrollToEnd="{Binding IsFollowing}"
                 AutomationProperties.Name="Log events">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource DenseItem}">
              <Setter Property="AutomationProperties.Name" Value="{Binding FirstLine}" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.InputBindings>
            <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyEntryCommand}" />
          </ListBox.InputBindings>
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Copy event" InputGestureText="Ctrl+C" Command="{Binding CopyEntryCommand}" />
              <MenuItem Header="Show file in Explorer" Command="{Binding RevealEntryCommand}" />
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Background="{Binding Severity, Converter={StaticResource RowBrush}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="205" />
                  <ColumnDefinition Width="58" />
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Timestamp, Converter={StaticResource Timestamp}}" Style="{StaticResource MonoText}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="6,2,8,2" />
                <Border Grid.Column="1" Style="{StaticResource Badge}" Background="{Binding Severity, Converter={StaticResource BadgeBrush}}">
                  <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Severity, Converter={StaticResource SeverityLabel}}" FontSize="10" />
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Badge}" Margin="4,0,8,0"
                        Background="{Binding Source.ColorIndex, Converter={StaticResource IndexBrush}}"
                        ToolTip="{Binding Source.FilePath}">
                  <TextBlock Style="{StaticResource BadgeText}" FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="96">
                    <Run Text="{Binding Source.Environment, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Source.FileName, Mode=OneWay}" />
                  </TextBlock>
                </Border>
                <DockPanel Grid.Column="3" Margin="0,2,6,2">
                  <TextBlock DockPanel.Dock="Right" Text="{Binding LineCount, StringFormat='{}{0} lines'}" FontSize="11" Margin="8,0,0,0"
                             Style="{StaticResource Muted}" VerticalAlignment="Center"
                             Visibility="{Binding IsMultiline, Converter={StaticResource VisibleWhen}}" />
                  <TextBlock Style="{StaticResource MonoText}" TextTrimming="CharacterEllipsis"
                             ctl:HighlightText.Highlights="{Binding DataContext.Highlights, RelativeSource={RelativeSource AncestorType=ListBox}}"
                             ctl:HighlightText.Text="{Binding FirstLine}" />
                </DockPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent" />

        <!-- Detail of the selected event -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="12,8">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Copy event" Command="{Binding CopyEntryCommand}" />
                <Button Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="Show file in Explorer" Command="{Binding RevealEntryCommand}" />
              </StackPanel>
              <TextBlock Text="{Binding SelectedEntry.Source.FilePath, FallbackValue='Select an event to see all of its lines.'}"
                         Style="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <TextBox Text="{Binding SelectedEntry.Text, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                     FontFamily="{StaticResource MonoFont}" FontSize="12.5" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     AutomationProperties.Name="Event text" />
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
