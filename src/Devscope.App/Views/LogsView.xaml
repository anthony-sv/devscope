<UserControl x:Class="Devscope.App.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Devscope.App.ViewModels"
             xmlns:ctl="clr-namespace:Devscope.App.Controls"
             xmlns:conv="clr-namespace:Devscope.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:LogsViewModel}"
             d:DesignWidth="1300" d:DesignHeight="800">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="290" MinWidth="220" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ===== Sidebar: workspaces and ad-hoc paths ===== -->
    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="16,16,8,16">
        <DockPanel Margin="0,0,0,6">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="New workspace" Command="{Binding NewWorkspaceCommand}" />
            <Button Style="{StaticResource IconButton}" Content="&#xE70F;" ToolTip="Edit workspace" Command="{Binding EditWorkspaceCommand}" />
            <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Delete workspace" Command="{Binding DeleteWorkspaceCommand}" />
          </StackPanel>
          <TextBlock Text="WORKSPACES" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0" />
        </DockPanel>

        <ComboBox ItemsSource="{Binding Workspaces}" SelectedItem="{Binding SelectedWorkspace}" DisplayMemberPath="Name"
                  AutomationProperties.Name="Workspace" />
        <TextBlock Text="No workspace yet. Create one to group an app's logs across environments."
                   Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                   Visibility="{Binding Workspaces.Count, Converter={StaticResource CollapsedWhen}}" />

        <ItemsControl ItemsSource="{Binding SelectedWorkspace.Environments}" Margin="0,8,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{Binding ColorIndex, Converter={StaticResource IndexBrush}}" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  </StackPanel>
                  <TextBlock Text="{Binding Summary}" FontSize="11" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" MaxWidth="220" ToolTip="{Binding Summary}" />
                </StackPanel>
              </CheckBox>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Content="Open selected environments" Command="{Binding OpenWorkspaceCommand}" Margin="0,8,0,0"
                HorizontalAlignment="Stretch" Style="{DynamicResource AccentButtonStyle}" />

        <TextBlock Text="QUICK OPEN" Style="{StaticResource SectionTitle}" Margin="0,24,0,6" />
        <TextBox Text="{Binding QuickPath, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                 ctl:Behaviors.AcceptsPathDrop="True" AutomationProperties.Name="Log file or folder path"
                 ToolTip="A log file or a folder (searched recursively). Local or \\server\share. Drop a file here." />
        <DockPanel Margin="0,6,0,0">
          <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Margin="0" Content="&#xE8E5;" ToolTip="Pick file" Command="{Binding BrowseQuickFileCommand}" />
          <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="Pick folder" Command="{Binding BrowseQuickFolderCommand}" />
          <Button Content="Open" Command="{Binding QuickOpenCommand}" Margin="6,0,0,0" HorizontalAlignment="Stretch" />
        </DockPanel>

        <!-- Files of the open session, by folder. Unticked files are hidden from the list. -->
        <StackPanel Visibility="{Binding FileTree.Count, Converter={StaticResource VisibleWhen}}">
          <DockPanel Margin="0,24,0,6">
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8FB;" FontSize="12" Padding="6,3" MinWidth="0"
                    ToolTip="Show all files" Command="{Binding ShowAllFilesCommand}"
                    Visibility="{Binding HasHiddenFiles, Converter={StaticResource VisibleWhen}}" />
            <TextBlock Text="FILES" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0" />
          </DockPanel>
          <TreeView ItemsSource="{Binding FileTree}" BorderThickness="0" Background="Transparent" MaxHeight="520"
                    AutomationProperties.Name="Files"
                    ToolTip="Untick files or folders to hide their events. Right-click for 'Show only this'.">
            <TreeView.ItemContainerStyle>
              <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                <Setter Property="Padding" Value="0,1" />
                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                <!-- The menu lives outside the visual tree: the page view model reaches it through Tag. -->
                <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}" />
                <Setter Property="ContextMenu">
                  <Setter.Value>
                    <ContextMenu>
                      <MenuItem Header="Show only this"
                                Command="{Binding PlacementTarget.Tag.ShowOnlyFilesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                      <MenuItem Header="Show all files"
                                Command="{Binding PlacementTarget.Tag.ShowAllFilesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                      <Separator />
                      <MenuItem Header="Show in Explorer"
                                Command="{Binding PlacementTarget.Tag.RevealFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                  </Setter.Value>
                </Setter>
              </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
              <HierarchicalDataTemplate DataType="{x:Type vm:LogFileNodeViewModel}" ItemsSource="{Binding Children}">
                <DockPanel ToolTip="{Binding ToolTip}">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ErrorCount, StringFormat='{}{0:N0} err · '}" FontSize="11" Foreground="{StaticResource ErrorBrush}"
                               Visibility="{Binding ErrorCount, Converter={StaticResource VisibleWhen}}" ToolTip="Errors and fatals" />
                    <TextBlock Text="{Binding Count, StringFormat='{}{0:N0}'}" FontSize="11" Style="{StaticResource Muted}" ToolTip="Events" />
                  </StackPanel>
                  <CheckBox IsChecked="{Binding IsChecked}" MinWidth="0" Padding="4,0,0,0" VerticalAlignment="Center"
                            AutomationProperties.Name="{Binding Name}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0">
                        <TextBlock.Text>
                          <Binding Path="IsFile">
                            <Binding.Converter><conv:BoolToTextConverter TrueText="&#xE8A5;" FalseText="&#xE8B7;" /></Binding.Converter>
                          </Binding>
                        </TextBlock.Text>
                      </TextBlock>
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="170" />
                    </StackPanel>
                  </CheckBox>
                </DockPanel>
              </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </StackPanel>

        <StackPanel Visibility="{Binding SourceStatuses.Count, Converter={StaticResource VisibleWhen}}">
          <TextBlock Text="SOURCES" Style="{StaticResource SectionTitle}" Margin="0,24,0,6" />
          <ItemsControl ItemsSource="{Binding SourceStatuses}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,8">
                  <TextBlock FontSize="12">
                    <Run Text="{Binding Environment, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="{Binding FileCount, Mode=OneWay, StringFormat='· {0} file(s)'}" />
                  </TextBlock>
                  <TextBlock Text="{Binding Path}" FontSize="11" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Error}" FontSize="11" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"
                             Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                  Background="{DynamicResource CardStrokeColorDefaultBrush}" />

    <!-- ===== Viewer ===== -->
    <Grid Grid.Column="2" Margin="8,16,16,16">
      <TextBlock Text="Open a workspace or a path to start tailing logs." Style="{StaticResource Muted}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Visibility="{Binding IsSessionOpen, Converter={StaticResource CollapsedWhen}}" />

      <Grid Visibility="{Binding IsSessionOpen, Converter={StaticResource VisibleWhen}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" MinHeight="120" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="240" MinHeight="60" />
        </Grid.RowDefinitions>

        <!-- Title and live controls -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <TextBlock Text="{Binding CountText}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding IsFollowing}" ToolTip="Follow (auto-scroll to newest)">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE74B;" />
            </ToggleButton>
            <ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding IsPaused}" ToolTip="Pause live updates (new lines are buffered)">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE769;" />
            </ToggleButton>
            <Button Style="{StaticResource IconButton}" Content="&#xE894;" ToolTip="Clear the view" Command="{Binding ClearCommand}" />
            <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Close" Command="{Binding CloseSessionCommand}" />
          </StackPanel>
          <ProgressBar DockPanel.Dock="Right" Width="80" Height="4" IsIndeterminate="True" Margin="12,0"
                       Visibility="{Binding IsLoading, Converter={StaticResource VisibleWhen}}" />
          <TextBlock Text="{Binding SessionTitle}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" ToolTip="{Binding SessionTitle}" />
        </DockPanel>

        <!-- Filters -->
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="3*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                     AutomationProperties.Name="Search" ToolTip="Show events containing this text (or matching this regex)" />
            <ToggleButton Grid.Column="1" Style="{StaticResource IconToggle}" IsChecked="{Binding UseRegex}" ToolTip="Regular expression"
                          Content=".*" FontFamily="{StaticResource MonoFont}" />
            <ToggleButton Grid.Column="2" Style="{StaticResource IconToggle}" IsChecked="{Binding MatchCase}" ToolTip="Match case"
                          Content="Aa" Margin="4,0,8,0" />
            <TextBox Grid.Column="3" Text="{Binding ExcludeText, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                     AutomationProperties.Name="Exclude" ToolTip="Hide events containing this text (or matching this regex)" />
          </Grid>
          <TextBlock Text="{Binding FilterError}" Foreground="{StaticResource ErrorBrush}" FontSize="12" Margin="0,4,0,0"
                     Visibility="{Binding FilterError, Converter={StaticResource VisibleWhen}}" />

          <WrapPanel Margin="0,8,0,0">
            <ItemsControl ItemsSource="{Binding SeverityChips}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding IsEnabled}">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="{Binding Value, Converter={StaticResource BadgeBrush}}" Stroke="{DynamicResource TextFillColorTertiaryBrush}" StrokeThickness="0.5" />
                      <TextBlock Text="{Binding Label}" />
                      <TextBlock Text="{Binding Count, StringFormat=' {0:N0}'}" Style="{StaticResource Muted}" />
                    </StackPanel>
                  </ToggleButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Width="1" Margin="6,4,12,4" Background="{DynamicResource CardStrokeColorDefaultBrush}" />
            <ItemsControl ItemsSource="{Binding EnvironmentChips}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding IsEnabled}">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="{Binding ColorIndex, Converter={StaticResource IndexBrush}}" />
                      <TextBlock Text="{Binding Label}" />
                      <TextBlock Text="{Binding Count, StringFormat=' {0:N0}'}" Style="{StaticResource Muted}" />
                    </StackPanel>
                  </ToggleButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </WrapPanel>
        </StackPanel>

        <!-- Column headers, each with its own filter. Widths match the row template below. -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,6" Margin="0,0,0,2">
          <Grid>
            <Grid.Resources>
              <Style x:Key="ColumnTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
                <Setter Property="Margin" Value="2,0,0,3" />
                <Setter Property="FontSize" Value="11" />
              </Style>
              <!-- Hint shown inside an empty filter box. -->
              <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="11,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Opacity" Value="0.7" />
              </Style>
              <Style x:Key="ColumnBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Padding" Value="8,3" />
              </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="205" />
              <ColumnDefinition Width="102" />
              <ColumnDefinition Width="150" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Column="0" Text="TIME" Style="{StaticResource ColumnTitle}" />
            <TextBlock Grid.Column="1" Text="LEVEL" Style="{StaticResource ColumnTitle}" />
            <TextBlock Grid.Column="2" Text="SOURCE" Style="{StaticResource ColumnTitle}" />
            <TextBlock Grid.Column="3" Text="MESSAGE" Style="{StaticResource ColumnTitle}" />

            <!-- Time range -->
            <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,6,0"
                  ToolTip="From / to (inclusive). 10:30 · 10:30:15 · 2026-10-16 10:30 · 2026-10-16 · -15m / -2h / -1d (relative to now)">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="TimeFromBox" Grid.Column="0" Style="{StaticResource ColumnBox}"
                       Text="{Binding TimeFrom, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Time from" />
              <TextBlock Grid.Column="0" Text="from" Style="{StaticResource Hint}"
                         Visibility="{Binding Text, ElementName=TimeFromBox, Converter={StaticResource CollapsedWhen}}" />
              <TextBlock Grid.Column="1" Text="–" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="3,0" />
              <TextBox x:Name="TimeToBox" Grid.Column="2" Style="{StaticResource ColumnBox}"
                       Text="{Binding TimeTo, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Time to" />
              <TextBlock Grid.Column="2" Text="to" Style="{StaticResource Hint}"
                         Visibility="{Binding Text, ElementName=TimeToBox, Converter={StaticResource CollapsedWhen}}" />
            </Grid>

            <!-- Minimum level -->
            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,6,0" MinWidth="0" FontSize="12"
                      ItemsSource="{x:Static vm:LogsViewModel.LevelOptions}" SelectedItem="{Binding MinimumLevel}" DisplayMemberPath="Label"
                      AutomationProperties.Name="Minimum level" ToolTip="Lowest level to show (works together with the level chips)" />

            <!-- Source -->
            <Grid Grid.Row="1" Grid.Column="2" Margin="0,0,6,0">
              <TextBox x:Name="SourceBox" Style="{StaticResource ColumnBox}" Text="{Binding SourceFilter, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Source filter" ToolTip="Text in the environment name or the file path, e.g. node2 or SubFolder1" />
              <TextBlock Text="env or path" Style="{StaticResource Hint}"
                         Visibility="{Binding Text, ElementName=SourceBox, Converter={StaticResource CollapsedWhen}}" />
            </Grid>

            <!-- Message -->
            <Grid Grid.Row="1" Grid.Column="3">
              <TextBox x:Name="MessageFilterBox" Style="{StaticResource ColumnBox}" Text="{Binding MessageFilter, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Message filter"
                       ToolTip="Text in the first line of the event (a regex when .* is on). The search box above looks at every line." />
              <TextBlock Text="first line contains…" Style="{StaticResource Hint}"
                         Visibility="{Binding Text, ElementName=MessageFilterBox, Converter={StaticResource CollapsedWhen}}" />
            </Grid>

            <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal">
              <ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding MultilineOnly}"
                            ToolTip="Only events with several lines, such as errors with a stack trace">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE8FD;" Margin="0,0,6,0" />
                  <TextBlock Text="Stack traces" FontSize="12" />
                </StackPanel>
              </ToggleButton>
              <Button Style="{StaticResource IconButton}" Content="&#xE894;" ToolTip="Clear the column filters" Command="{Binding ClearColumnFiltersCommand}"
                      Visibility="{Binding HasColumnFilters, Converter={StaticResource VisibleWhen}}" />
            </StackPanel>

            <TextBlock Grid.Row="2" Grid.ColumnSpan="5" Text="{Binding TimeFilterError}" Foreground="{StaticResource ErrorBrush}" FontSize="12" Margin="0,4,0,0"
                       Visibility="{Binding TimeFilterError, Converter={StaticResource VisibleWhen}}" />
          </Grid>
        </Border>

        <!-- Event list (virtualized; handles hundreds of thousands of rows) -->
        <ListBox x:Name="EventList" Grid.Row="3" ItemsSource="{Binding VisibleEntries}" SelectedItem="{Binding SelectedEntry}"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ctl:Behaviors.AutoScrollToEnd="{Binding IsFollowing}"
                 AutomationProperties.Name="Log events">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource DenseItem}">
              <Setter Property="AutomationProperties.Name" Value="{Binding FirstLine}" />
              <EventSetter Event="MouseDoubleClick" Handler="OnEntryDoubleClick" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.InputBindings>
            <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyEntryCommand}" />
            <KeyBinding Key="Enter" Command="{Binding OpenEntryCommand}" />
          </ListBox.InputBindings>
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Open in window" InputGestureText="Enter" Command="{Binding OpenEntryCommand}" />
              <MenuItem Header="Copy event" InputGestureText="Ctrl+C" Command="{Binding CopyEntryCommand}" />
              <MenuItem Header="Show file in Explorer" Command="{Binding RevealEntryCommand}" />
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Background="{Binding Severity, Converter={StaticResource RowBrush}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="205" />
                  <ColumnDefinition Width="102" />
                  <ColumnDefinition Width="150" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Timestamp, Converter={StaticResource Timestamp}}" Style="{StaticResource MonoText}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="6,2,8,2" />
                <Border Grid.Column="1" Style="{StaticResource Badge}" Background="{Binding Severity, Converter={StaticResource BadgeBrush}}">
                  <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Severity, Converter={StaticResource SeverityLabel}}" FontSize="10" />
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Badge}" Margin="4,0,8,0"
                        Background="{Binding Source.ColorIndex, Converter={StaticResource IndexBrush}}"
                        ToolTip="{Binding Source.FilePath}">
                  <TextBlock Style="{StaticResource BadgeText}" FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="132">
                    <Run Text="{Binding Source.Environment, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Source.FileName, Mode=OneWay}" />
                  </TextBlock>
                </Border>
                <DockPanel Grid.Column="3" Margin="0,2,6,2">
                  <TextBlock DockPanel.Dock="Right" Text="{Binding LineCount, StringFormat='{}{0} lines'}" FontSize="11" Margin="8,0,0,0"
                             Style="{StaticResource Muted}" VerticalAlignment="Center"
                             Visibility="{Binding IsMultiline, Converter={StaticResource VisibleWhen}}" />
                  <TextBlock Style="{StaticResource MonoText}" TextTrimming="CharacterEllipsis"
                             ctl:HighlightText.Highlights="{Binding DataContext.Highlights, RelativeSource={RelativeSource AncestorType=ListBox}}"
                             ctl:HighlightText.Text="{Binding FirstLine}" />
                </DockPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <GridSplitter Grid.Row="4" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent" />

        <!-- Detail of the selected event -->
        <Border Grid.Row="5" Style="{StaticResource Card}" Padding="0">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="12,8">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="{Binding SelectedEntry.LineCount, StringFormat='{}{0:N0} lines'}" Style="{StaticResource Muted}" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,8,0"
                           Visibility="{Binding SelectedEntry.IsMultiline, Converter={StaticResource VisibleWhen}, FallbackValue=Collapsed}" />
                <Button Style="{StaticResource IconButton}" Content="&#xE8A7;" ToolTip="Open in window, with the whole stack trace (Enter or double-click)"
                        Command="{Binding OpenEntryCommand}" />
                <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Copy event" Command="{Binding CopyEntryCommand}" />
                <Button Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="Show file in Explorer" Command="{Binding RevealEntryCommand}" />
              </StackPanel>
              <TextBlock Text="{Binding SelectedEntry.Source.FilePath, FallbackValue='Select an event to see all of its lines.'}"
                         Style="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <TextBox Text="{Binding SelectedEntry.Text, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                     FontFamily="{StaticResource MonoFont}" FontSize="12.5" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     AutomationProperties.Name="Event text" />
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
