<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Devscope.App.Converters"
                    xmlns:ctl="clr-namespace:Devscope.App.Controls">

  <conv:EnumToBrushConverter x:Key="BadgeBrush" Suffix="Brush" />
  <conv:EnumToBrushConverter x:Key="RowBrush" Suffix="RowBrush" />
  <conv:EnumToBrushConverter x:Key="LeftLineBrush" Suffix="LeftLineBrush" />
  <conv:EnumToBrushConverter x:Key="RightLineBrush" Suffix="RightLineBrush" />
  <conv:EnumToBrushConverter x:Key="LeftGutterBrush" Suffix="LeftGutterBrush" />
  <conv:EnumToBrushConverter x:Key="RightGutterBrush" Suffix="RightGutterBrush" />
  <conv:DiffMarkerConverter x:Key="LeftMarker" Marker="-" />
  <conv:DiffMarkerConverter x:Key="RightMarker" Marker="+" />
  <conv:IndexToBrushConverter x:Key="IndexBrush" />
  <conv:SeverityLabelConverter x:Key="SeverityLabel" />
  <conv:TimestampConverter x:Key="Timestamp" />
  <conv:BytesConverter x:Key="Bytes" />
  <conv:VisibilityConverter x:Key="VisibleWhen" />
  <conv:VisibilityConverter x:Key="CollapsedWhen" Invert="True" />

  <!-- Surface for grouped content. Fluent resource keys fall back gracefully if a key is missing. -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <Style x:Key="SectionTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>

  <Style x:Key="Muted" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>

  <Style x:Key="Icon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Compact button with an icon glyph as content. Put the label in ToolTip. -->
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="Margin" Value="4,0,0,0" />
    <!-- Icon-only buttons: expose the tooltip text to screen readers and UI automation. -->
    <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
  </Style>

  <Style x:Key="IconToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
    <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="Margin" Value="4,0,0,0" />
  </Style>

  <!-- Filter chip: toggle with a coloured dot, label and count. -->
  <Style x:Key="Chip" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style x:Key="Badge" TargetType="Border">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="BadgeText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="MonoText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>

  <!-- Dense list rows for large virtualized lists. -->
  <Style x:Key="DenseItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <!--
    Side-by-side diff rows. The selection is an accent outline with a bar on the left instead of a fill, so the
    selected line (the current change, when navigating) keeps showing what kind of change it is.
  -->
  <Style x:Key="DiffLineItem" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid Background="Transparent">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
            <Border x:Name="Hover" Background="#808080" Opacity="0.08" Visibility="Collapsed" IsHitTestVisible="False" />
            <Border x:Name="Outline" BorderThickness="1" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                    Visibility="Collapsed" IsHitTestVisible="False" />
            <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" Background="{DynamicResource AccentFillColorDefaultBrush}"
                    Visibility="Collapsed" IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Hover" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Outline" Property="Visibility" Value="Visible" />
              <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- One row of a side-by-side text diff, shared by the EAR diff and the database diff. The list's DataContext provides Zoom. -->
  <DataTemplate x:Key="SideBySideLineTemplate">
    <Grid>
      <!-- Zoom scales text, line numbers and gutters together; a layout transform also re-wraps long lines. -->
      <Grid.LayoutTransform>
        <ScaleTransform ScaleX="{Binding DataContext.Zoom.Scale, RelativeSource={RelativeSource AncestorType=ListBox}}"
                        ScaleY="{Binding DataContext.Zoom.Scale, RelativeSource={RelativeSource AncestorType=ListBox}}" />
      </Grid.LayoutTransform>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="44" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="44" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Grid.ColumnSpan="3" Background="{Binding LeftKind, Converter={StaticResource LeftLineBrush}}" />
      <Border Grid.Column="0" Grid.ColumnSpan="2" Background="{Binding LeftKind, Converter={StaticResource LeftGutterBrush}}" />
      <Border Grid.Column="3" Grid.ColumnSpan="3" Background="{Binding RightKind, Converter={StaticResource RightLineBrush}}" />
      <Border Grid.Column="3" Grid.ColumnSpan="2" Background="{Binding RightKind, Converter={StaticResource RightGutterBrush}}" />

      <TextBlock Grid.Column="0" Text="{Binding LeftNumber}" Style="{StaticResource MonoText}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                 TextAlignment="Right" Margin="0,0,6,0" />
      <TextBlock Grid.Column="1" Text="{Binding LeftKind, Converter={StaticResource LeftMarker}}" Style="{StaticResource MonoText}"
                 Foreground="{StaticResource DeletedMarkerBrush}" FontWeight="Bold" TextAlignment="Center" />
      <TextBlock Grid.Column="2" Style="{StaticResource MonoText}" TextWrapping="Wrap" Margin="2,0,8,0"
                 ctl:DiffText.Text="{Binding LeftText}" ctl:DiffText.Spans="{Binding LeftSpans}"
                 ctl:DiffText.ChangedBrush="{StaticResource DeletedWordBrush}" />

      <TextBlock Grid.Column="3" Text="{Binding RightNumber}" Style="{StaticResource MonoText}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                 TextAlignment="Right" Margin="0,0,6,0" />
      <TextBlock Grid.Column="4" Text="{Binding RightKind, Converter={StaticResource RightMarker}}" Style="{StaticResource MonoText}"
                 Foreground="{StaticResource InsertedMarkerBrush}" FontWeight="Bold" TextAlignment="Center" />
      <TextBlock Grid.Column="5" Style="{StaticResource MonoText}" TextWrapping="Wrap" Margin="2,0,0,0"
                 ctl:DiffText.Text="{Binding RightText}" ctl:DiffText.Spans="{Binding RightSpans}"
                 ctl:DiffText.ChangedBrush="{StaticResource InsertedWordBrush}" />
    </Grid>
  </DataTemplate>
</ResourceDictionary>
