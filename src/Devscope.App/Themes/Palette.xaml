<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Semantic colours. Badges are solid; row tints are translucent so they work on both the
    light and dark Fluent backgrounds. Everything else comes from the Fluent theme resources.
  -->
  <FontFamily x:Key="MonoFont">Cascadia Mono, Cascadia Code, Consolas, Courier New</FontFamily>
  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <SolidColorBrush x:Key="FatalBrush" Color="#B10E1C" />
  <SolidColorBrush x:Key="ErrorBrush" Color="#D13438" />
  <SolidColorBrush x:Key="WarningBrush" Color="#C77C02" />
  <SolidColorBrush x:Key="InfoBrush" Color="#0F6CBD" />
  <SolidColorBrush x:Key="DebugBrush" Color="#6E6E6E" />
  <SolidColorBrush x:Key="TraceBrush" Color="#8A8A8A" />
  <SolidColorBrush x:Key="UnknownBrush" Color="Transparent" />

  <SolidColorBrush x:Key="FatalRowBrush" Color="#40D13438" />
  <SolidColorBrush x:Key="ErrorRowBrush" Color="#24D13438" />
  <SolidColorBrush x:Key="WarningRowBrush" Color="#1FF7A600" />

  <SolidColorBrush x:Key="AddedBrush" Color="#2DA44E" />
  <SolidColorBrush x:Key="RemovedBrush" Color="#CF222E" />
  <SolidColorBrush x:Key="ModifiedBrush" Color="#BF8700" />
  <SolidColorBrush x:Key="UnchangedBrush" Color="#8A8A8A" />

  <!--
    Side-by-side diff, using git's convention: the old (left) side of a deleted or modified line is red, the new
    (right) side of an inserted or modified line is green. Keys are <DiffLineKind><Side><Part>; a missing key
    (e.g. an unchanged line) means no background. Translucent, so they read on light and dark themes alike.
  -->
  <Color x:Key="DiffRedColor">#F85149</Color>
  <Color x:Key="DiffGreenColor">#3FB950</Color>
  <SolidColorBrush x:Key="DeletedLeftLineBrush" Color="{StaticResource DiffRedColor}" Opacity="0.15" />
  <SolidColorBrush x:Key="ModifiedLeftLineBrush" Color="{StaticResource DiffRedColor}" Opacity="0.15" />
  <SolidColorBrush x:Key="InsertedRightLineBrush" Color="{StaticResource DiffGreenColor}" Opacity="0.15" />
  <SolidColorBrush x:Key="ModifiedRightLineBrush" Color="{StaticResource DiffGreenColor}" Opacity="0.15" />
  <SolidColorBrush x:Key="DeletedLeftGutterBrush" Color="{StaticResource DiffRedColor}" Opacity="0.28" />
  <SolidColorBrush x:Key="ModifiedLeftGutterBrush" Color="{StaticResource DiffRedColor}" Opacity="0.28" />
  <SolidColorBrush x:Key="InsertedRightGutterBrush" Color="{StaticResource DiffGreenColor}" Opacity="0.28" />
  <SolidColorBrush x:Key="ModifiedRightGutterBrush" Color="{StaticResource DiffGreenColor}" Opacity="0.28" />
  <!-- Padding opposite an inserted or deleted line: neutral, so it never looks like a change of its own. -->
  <SolidColorBrush x:Key="ImaginaryLeftLineBrush" Color="#808080" Opacity="0.08" />
  <SolidColorBrush x:Key="ImaginaryRightLineBrush" Color="#808080" Opacity="0.08" />
  <SolidColorBrush x:Key="ImaginaryLeftGutterBrush" Color="#808080" Opacity="0.08" />
  <SolidColorBrush x:Key="ImaginaryRightGutterBrush" Color="#808080" Opacity="0.08" />
  <!-- The words that actually changed inside a modified line. -->
  <SolidColorBrush x:Key="DeletedWordBrush" Color="{StaticResource DiffRedColor}" Opacity="0.45" />
  <SolidColorBrush x:Key="InsertedWordBrush" Color="{StaticResource DiffGreenColor}" Opacity="0.45" />
  <SolidColorBrush x:Key="DeletedMarkerBrush" Color="{StaticResource DiffRedColor}" />
  <SolidColorBrush x:Key="InsertedMarkerBrush" Color="{StaticResource DiffGreenColor}" />
</ResourceDictionary>
